CFG=/etc/rancher/rke2/rke2.yaml

sudo $K --kubeconfig "$CFG" get nodes -o wide

sudo $K --kubeconfig "$CFG" get pods -A -o wide

sudo $K --kubeconfig "$CFG" get node master01 \
  -o jsonpath='{range .status.conditions[*]}{.type}{"="}{.status}{" reason="}{.reason}{" message="}{.message}{"\n"}{end}'

grep -nA25 -B10 \
  'Wait for remaining nodes to be ready - no CNI' \
  roles/lablabs.rke2/tasks/remaining_nodes.yml
```

Those results will tell us whether this is simply the role's no-CNI wait logic, an inventory/`--limit` interaction, or a real bootstrap problem.
