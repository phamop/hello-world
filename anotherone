mkdir -p scripts

cat > scripts/fix-cilium-spire.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

INVENTORY="inventory/dev/hosts.ini"
HOST="master01"

KUBECTL="/var/lib/rancher/rke2/bin/kubectl"
KUBECONFIG="/etc/rancher/rke2/rke2.yaml"
HELM="/usr/bin/helm"

CILIUM_RELEASE="cilium"
CILIUM_NAMESPACE="kube-system"
SPIRE_NAMESPACE="cilium-spire"
VALUES_FILE="/var/tmp/cilium/cilium-values.yaml"
CHART="helm-virtual/cilium"

echo "============================================================"
echo " Cilium SPIRE Repair"
echo "============================================================"
echo
echo "Target host       : ${HOST}"
echo "Cilium release    : ${CILIUM_RELEASE}"
echo "Cilium namespace  : ${CILIUM_NAMESPACE}"
echo "SPIRE namespace   : ${SPIRE_NAMESPACE}"
echo

echo "=== 1. Verify master01 is reachable ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -m ping

echo
echo "=== 2. Verify Kubernetes API ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} get nodes"

echo
echo "=== 3. Verify Helm ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${HELM} version --short"

echo
echo "=== 4. Verify Cilium values file ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "test -s ${VALUES_FILE} && ls -lh ${VALUES_FILE}"

echo
echo "=== 5. Show current SPIRE state ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} get pods -n ${SPIRE_NAMESPACE} -o wide || true"

echo
echo "=== 6. Remove failed SPIRE server/agent workloads ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} delete statefulset spire-server -n ${SPIRE_NAMESPACE} --ignore-not-found=true"

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} delete daemonset spire-agent -n ${SPIRE_NAMESPACE} --ignore-not-found=true"

echo
echo "=== 7. Remove stale SPIRE PVC if present ==="
echo "This deployment will temporarily use in-memory SPIRE storage."

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} delete pvc -n ${SPIRE_NAMESPACE} --all --ignore-not-found=true"

echo
echo "=== 8. Refresh Helm repository ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${HELM} repo update"

echo
echo "=== 9. Upgrade Cilium and disable SPIRE persistent storage ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "KUBECONFIG=${KUBECONFIG} ${HELM} upgrade --install ${CILIUM_RELEASE} ${CHART} \
      --namespace ${CILIUM_NAMESPACE} \
      --create-namespace \
      --values ${VALUES_FILE} \
      --set authentication.mutual.spire.install.server.dataStorage.enabled=false \
      --wait \
      --timeout 10m"

echo
echo "=== 10. Wait for SPIRE server ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} rollout status statefulset/spire-server \
      -n ${SPIRE_NAMESPACE} \
      --timeout=300s"

echo
echo "=== 11. Wait for SPIRE agents ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} rollout status daemonset/spire-agent \
      -n ${SPIRE_NAMESPACE} \
      --timeout=300s"

echo
echo "=== 12. Restart Cilium operator ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} rollout restart deployment/cilium-operator \
      -n ${CILIUM_NAMESPACE}"

echo
echo "=== 13. Restart Cilium agents ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} rollout restart daemonset/cilium \
      -n ${CILIUM_NAMESPACE}"

echo
echo "=== 14. Wait for Cilium operator ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} rollout status deployment/cilium-operator \
      -n ${CILIUM_NAMESPACE} \
      --timeout=300s"

echo
echo "=== 15. Wait for Cilium DaemonSet ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} rollout status daemonset/cilium \
      -n ${CILIUM_NAMESPACE} \
      --timeout=300s"

echo
echo "=== 16. Final SPIRE status ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} get pods -n ${SPIRE_NAMESPACE} -o wide"

echo
echo "=== 17. Final Cilium status ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} get pods -n ${CILIUM_NAMESPACE} -o wide | grep -E 'NAME|cilium|hubble'"

echo
echo "=== 18. Final node status ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "${KUBECTL} --kubeconfig ${KUBECONFIG} get nodes -o wide"

echo
echo "=== 19. Helm release status ==="

ansible "${HOST}" \
  -i "${INVENTORY}" \
  -b \
  -m shell \
  -a "KUBECONFIG=${KUBECONFIG} ${HELM} status ${CILIUM_RELEASE} -n ${CILIUM_NAMESPACE}"

echo
echo "============================================================"
echo " Cilium SPIRE repair completed"
echo "============================================================"
EOF
